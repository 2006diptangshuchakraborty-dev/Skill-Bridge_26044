{
  "name": "sih-2026-skill-mapping-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SIH 2026 Industry Collaboration Platform for Skill Mapping, Internships and Placement with Priority-Aware Skill Matching Engine",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed.js",
    "db:generate": "drizzle-kit generate --hints-file ./drizzle/generate-hints.json",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --hints-file ./drizzle/generate-hints.json",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "node scripts/seed.js",
    "db:test": "node scripts/test-db.js",
    "import:mcq": "node --env-file=.env.local scripts/import-questions.js",
    "test": "node tests/test-auth-onboarding-e2e.js",
    "test:auth": "node tests/test-auth-onboarding-e2e.js",
    "test:tier5": "node tests/test-tier5-adversarial-auth.js",
    "test:all": "node tests/test-auth-onboarding-e2e.js && node tests/test-tier5-adversarial-auth.js",
    "test:matching": "node scripts/test-matching-rules.js",
    "test:verification": "node tests/test-verification-system.js",
    "test:persistence": "node tests/test-profile-persistence-e2e.js",
    "test:e2e": "node tests/test-auth-onboarding-e2e.js && node tests/test-tier5-adversarial-auth.js && node scripts/test-matching-rules.js && node tests/test-verification-system.js && node tests/test-profile-persistence-e2e.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fs": "^0.0.1-security",
    "lucide-react": "^0.428.0",
    "next": "14.2.5",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^1.0.0-rc.4",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
